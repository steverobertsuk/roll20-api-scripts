{
  "name": "inspirationtracker-roll20",
  "version": "1.0.0",
  "description": "Roll20 API Mod that tracks D&D 5e Inspiration and Heroic Inspiration on the 2014 and 2024 sheets, with token markers, player spending and a party overview.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "set-version": "node scripts/bump-version.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test \"tests/*.test.mjs\"",
    "format": "prettier --write \"InspirationTracker.js\" \"rollup.config.js\" \"src/**/*.js\" \"tests/**/*.mjs\" \"*.md\" \"scripts/**/*.mjs\"",
    "sync-locales": "node scripts/sync-locales.mjs",
    "regenerate-locales": "node scripts/sync-locales.mjs --regenerate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "rollup": "^4.34.8"
  }
}
